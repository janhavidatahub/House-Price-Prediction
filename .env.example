# ─── HousePriceBot Backend — Environment Variables ──────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the real .env file to git.
#
# For LOCAL TESTING without WhatsApp, only PORT and ML_SERVICE_URL are needed.
# The WhatsApp variables are only required for live WhatsApp integration.
# ────────────────────────────────────────────────────────────────────────────

# Port the Node.js Express server will listen on
PORT=3000

# URL of the Python FastAPI ML service
# Change this if you run the ML service on a different host or port
ML_SERVICE_URL=http://localhost:8000

# ─── WhatsApp Cloud API Credentials ─────────────────────────────────────────
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup

# A secret string you choose — used to verify that Meta's webhook calls are genuine
# Set the same value in the Meta Developer Portal when registering your webhook URL
WHATSAPP_VERIFY_TOKEN=mysql123

# Permanent or temporary access token from Meta Developer Portal
WHATSAPP_ACCESS_TOKEN=EAAUnJudVyZCEBSrf325onEK2mGfbDj3exyJnIXxlw0lgcKMwvvxHNVEAWd6OIcmCGkYXbzqrpgxLyQxWLMQq1PXSQZCQI8kRcahr9Ms0bfwSlsqR1nxKzqbo80ZCZC2Dbw207GkF2oQzjknDkZC9PjwvYI8eYZB0HkIjNK1YvTp9cgEXZCSAeneMcoT3e9VD2eOKw4LX4ZAJvx5F8B3WZBcDc623uz6wNVbgLxHPZCsS097DEhxouKktPJ8hNEHrVjXOOdPU16fZB7uN5u9IW0hS0mG

# The phone number ID (not the phone number itself) from Meta Developer Portal
WHATSAPP_PHONE_NUMBER_ID=1305322716000213

# Meta Graph API version to use (check Meta docs for the latest stable version)
GRAPH_API_VERSION=v20.0
